 void doomgeneric_Tick()
 {
+    if (DG_WipeActive())
+    {
+        int tics = DG_WipeTics();
+
+        if (tics > 0)
+        {
+            boolean done = wipe_ScreenWipe(wipe_Melt, 0, 0, SCREENWIDTH, SCREENHEIGHT, tics);
+            I_UpdateNoBlit ();
+            M_Drawer ();
+            I_FinishUpdate ();
+            if (done)
+            {
+                DG_WipeEnd();
+            }
+        }
+        return;
+    }
+
     // frame syncronous IO operations
     I_StartFrame ();
 
